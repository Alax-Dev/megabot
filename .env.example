# ── Telegram (required) ────────────────────────────────
API_ID=12345678                # from my.telegram.org
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456789:AA...      # from @BotFather
OWNER_ID=111111111             # your Telegram user id (owner panel)
BOT_USERNAME=@YourMegaBot      # optional, used in help text

# ── MongoDB (required) ─────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_NAME=megabot

# ── MEGA account (required for downloads) ─────────────
MEGA_EMAIL=you@example.com
MEGA_PASSWORD=your-mega-password

# ── OpenRouter AI (optional) ──────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Tuning (all optional) ──────────────────────────────
# DOWNLOAD_DIR=/home/codespace/mybot/megabot/downloads
# MAX_FILE_SIZE_MB=2000
# MAX_CONCURRENT_JOBS=2
# MAX_JOBS_PER_USER=1
# MIN_FREE_DISK_MB=500
# LINK_CACHE_TTL_H=24
# RETRY_ATTEMPTS=3
# PROGRESS_EDIT_INTERVAL=3.0
# MIN_IMAGES_FOR_PDF=3